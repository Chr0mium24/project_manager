{
  "name": "project-manager",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <21"
  },
  "volta": {
    "node": "20.19.5",
    "npm": "10.8.2",
    "pnpm": "9.15.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "create:project": "node --import tsx scripts/create-project.ts",
    "start:managed-task": "node --import tsx scripts/start-managed-task.ts",
    "summarize:managed-task": "node --import tsx scripts/summarize-managed-task.ts",
    "validate:managed-task": "node --import tsx scripts/validate-managed-task.ts",
    "apply:managed-task": "node --import tsx scripts/apply-managed-task.ts",
    "validate:content-repo": "node --import tsx scripts/validate-content-repo.ts",
    "dev:gateway": "node --import tsx apps/gateway/src/index.ts",
    "format:check": "node scripts/check-format.mjs",
    "lint": "node scripts/check-repo-lint.mjs",
    "typecheck": "node scripts/check-typecheck-readiness.mjs",
    "test:unit": "node --test tests/doc-consistency.test.mjs tests/no-compat-policy.test.mjs tests/changed-scope.test.mjs tests/module-boundaries.test.mjs && node --import tsx --test packages/project-core/src/*.test.ts apps/gateway/src/index.test.ts",
    "test:integration": "node --test tests/route-registry.test.mjs tests/quality-gate-stamp.test.mjs tests/branch-policy.test.mjs tests/no-pr-policy.test.mjs",
    "test:contract": "npm run validate:content-repo",
    "test:e2e:smoke": "node --test tests/route-registry.test.mjs && node --import tsx --test tests/gateway-server-smoke.test.mjs",
    "test:git": "node --test tests/quality-gate-stamp.test.mjs tests/branch-policy.test.mjs tests/no-pr-policy.test.mjs",
    "test:ai": "node --test tests/codex-cli-capabilities.test.mjs tests/codex-live-probe.test.mjs",
    "test:publish": "node --test tests/route-registry.test.mjs",
    "quality-gate": "./scripts/run-quality-gate.sh"
  },
  "devDependencies": {
    "@eslint/js": "9.24.0",
    "@types/node": "24.5.2",
    "dependency-cruiser": "16.10.4",
    "eslint": "9.24.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-sonarjs": "3.0.2",
    "globals": "16.0.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.57.1"
  }
}
