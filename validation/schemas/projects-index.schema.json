{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "projects-index.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generatedAt",
    "projects"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "path",
          "name",
          "runtime",
          "visibility",
          "entry",
          "route",
          "updatedAt"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{1,62}[a-z0-9])?$"
          },
          "path": {
            "type": "string",
            "pattern": "^projects\\/[a-z0-9](?:[a-z0-9-]{1,62}[a-z0-9])?$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "runtime": {
            "type": "string",
            "enum": ["static", "dynamic"]
          },
          "visibility": {
            "type": "string",
            "enum": ["private", "unlisted"]
          },
          "entry": {
            "type": "string",
            "pattern": "^src\\/.+"
          },
          "route": {
            "type": "string",
            "pattern": "^\\/[A-Za-z0-9._\\/-]+$"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
